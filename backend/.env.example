# --- Docker Compose: Postgres container (init on first start only) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aos

# Must match POSTGRES_* above.
# - Docker Compose backend container: host must be `db` (the db service name).
# - uvicorn on your machine with Postgres in Compose on same machine: host `localhost` if port 5432 is published.
# - uvicorn on your machine with Postgres on a VPS: use the VPS IP or hostname (not `db`).
# If you change POSTGRES_USER or password, recreate DB data: docker compose down -v
DATABASE_URL=postgresql://postgres:change-me@db:5432/aos
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=use-a-long-random-string
# Local Vite dev (proxy /api):
BASE_URL=http://localhost:5173
# Docker on VPS (QR / scan links = BASE_URL + /scan/…, same as browser):
# BASE_URL=http://46.225.168.215/aos

# JD per ticket (stored on each row when the ticket is created)
ADULT_TICKET_PRICE_JD=3
KID_TICKET_PRICE_JD=12

# Dashboard “scans today” uses this timezone (GMT+3 for Jordan)
# EVENT_TIMEZONE=Asia/Amman
