# Remote example: postgresql://USER:PASSWORD@HOST:5432/aos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aos
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=use-a-long-random-string
# Local Vite dev (proxy /api):
BASE_URL=http://localhost:5173
# Docker on VPS (QR / scan links must match the browser URL, including https://):
# BASE_URL=https://46.225.168.215

# JD per ticket (stored on each row when the ticket is created)
ADULT_TICKET_PRICE_JD=3
KID_TICKET_PRICE_JD=12

# Dashboard “scans today” uses this timezone (GMT+3 for Jordan)
# EVENT_TIMEZONE=Asia/Amman
